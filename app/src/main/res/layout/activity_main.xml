<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <ImageView
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:contentDescription="象棋辅助 Logo"
            android:src="@drawable/app_logo_large" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="象棋辅助"
            android:textColor="@color/brand_gold_300"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="本地识别 · 引擎分析 · 棋谱研习"
            android:textColor="@color/brand_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/app_panel_bg"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_play"
                style="@style/Widget.XiangqiAssist.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="对弈"
                android:textAllCaps="false"
                app:icon="@drawable/game"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/brand_navy_950" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_link"
                style="@style/Widget.XiangqiAssist.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="悬浮窗辅助"
                android:textAllCaps="false"
                app:icon="@drawable/intelligence"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/brand_gold_300" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_learn"
                style="@style/Widget.XiangqiAssist.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="打谱与复盘"
                android:textAllCaps="false"
                app:icon="@drawable/manual"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/brand_gold_300" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_help"
                    style="@style/Widget.XiangqiAssist.Button.Quiet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="帮助"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_about"
                    style="@style/Widget.XiangqiAssist.Button.Quiet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="关于"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="所有识别与计算均在设备本地完成"
            android:textColor="#8FAEBBC9"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
